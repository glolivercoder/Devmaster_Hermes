# ─── Hermes Control Center — Environment Variables ──────────────────────────
# Copy to .env and fill in your real values. NEVER commit .env to git.
# Para importar em lote a partir de arquivos .txt: scripts/import-apis.ps1

# ─── LLM Providers ──────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
COMPOSIO_API_KEY=
VERTEX_AI_API_KEY=
NVIDIA_API_KEY=

# ─── Search / Web / Data Providers ──────────────────────────────────────────
SERPAPI_API_KEY=
TAVILY_API_KEY=
BRAVE_API_KEY=
LINKUP_API_KEY=
FINNHUB_API_KEY=
FINANCIAL_MODELING_PREP_API_KEY=
FREEPIK_API_KEY=
WAVESPEED_API_KEY=
ELEVENLABS_API_KEY=
CONTEXT7_API_KEY=
SUPERMEMORY_API_KEY=
TESTSPRITE_API_KEY=
GOOGLE_API_KEY=
GITHUB_TOKEN=

# ─── Base URLs dos servicos externos ────────────────────────────────────────
SERPAPI_BASE_URL=https://serpapi.com
TAVILY_BASE_URL=https://api.tavily.com
BRAVE_SEARCH_BASE_URL=https://api.search.brave.com/res/v1
NVIDIA_BUILD_BASE_URL=https://integrate.api.nvidia.com/v1
LINKUP_BASE_URL=https://api.linkup.so
ELEVENLABS_BASE_URL=https://api.elevenlabs.io/v1
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINANCIAL_MODELING_PREP_BASE_URL=https://financialmodelingprep.com
FREEPIK_BASE_URL=https://api.freepik.com
WAVESPEED_BASE_URL=https://api.wavespeed.ai
SUPERMEMORY_BASE_URL=https://api.supermemory.ai
GITHUB_API_URL=https://api.github.com
VERTEX_AI_BASE_URL=https://us-central1-aiplatform.googleapis.com
CONTEXT7_BASE_URL=https://api.context7.com

# ─── LiteLLM Gateway ────────────────────────────────────────────────────────
LITELLM_MASTER_KEY=sk-hermes-master-change-me

# ─── PostgreSQL ─────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=hermes_pg_change_me

# ─── Telegram Bot ───────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_ID=

# ─── Infisical (secret manager for non-LLM keys) ────────────────────────────
INFISICAL_TOKEN=

# ─── Gitea local (versionamento, endpoints e backup) ────────────────────────
# Suba com Docker:  docker compose up -d gitea   →  http://localhost:3011
# Crie o usuário administrador na primeira execução, gere um token em
# Settings → Applications → Generate Token e informe abaixo.
# Em DEV LOCAL (npm run dev) o Hermes fala com http://localhost:3011.
# Em DOCKER COMPOSE a URL é sobrescrita para http://gitea:3011 automaticamente.
GITEA_BASE_URL=http://localhost:3011
GITEA_TOKEN=
GITEA_OWNER=

